APP_NAME=Laravel
# Entorno: local (desarrollo) | production (deploy). Define APP_DEBUG y CORS.
APP_ENV=local
APP_KEY=
# true captura errores detallados en pantalla (solo en desarrollo).
APP_DEBUG=true
APP_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Servidor de desarrollo (artisan serve). El framework lee SERVER_HOST y
# SERVER_PORT de forma nativa; en cada PAQUETE se sobre escribe con las
# variables particulares del despliegue.
#
#   Desarrollo  -> SERVER_PORT=8000,  SERVER_HOST=127.0.0.1
#   Producción  -> SERVER_PORT=80/443, SERVER_HOST=0.0.0.0 (tras el proxy/LB)
# ---------------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# ---------------------------------------------------------------------------
# CORS: orígenes permitidos para la SPA (frontend Vue). Separa varios con ",".
#   Desarrollo  -> http://localhost:5173 (Vite dev server)
#   Producción  -> https://midominio.com
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ---------------------------------------------------------------------------
# Módulo de Tesis de Grado (flujo del estudiante).
#
#   TESIS_PLAZO_PRESENTACION_MESES -> meses para presentar el documento final
#       desde la aprobación del perfil (reglamento: entre 3 y 12; el sistema
#       acota el valor siempre a ese rango). Valor por defecto: 12.
#   TESIS_DIAS_CORRECCION -> días para corregir cuando la revisión es
#       insuficiente o la defensa no fue aprobada. Valor por defecto: 90.
# ---------------------------------------------------------------------------
TESIS_PLAZO_PRESENTACION_MESES=12
TESIS_DIAS_CORRECCION=90

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
