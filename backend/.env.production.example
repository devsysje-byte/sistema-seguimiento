##############################################################################
# .env.production.example — PLANTILLA para el entorno de PRODUCCIÓN (Laravel 13)
#
# ⚠️ NUNCA subas este archivo renombrado (`.env`) a Git. El `.gitignore` del
#    repositorio ya excluye `backend/.env*`. Este archivo es solo una plantilla
#    segura de referencia. En el servidor se debe desplegar como `.env`.
#
# PASOS MÍNIMOS ANTES DE ARRANCAR EN PRODUCCIÓN:
#   1) cp .env.production.example .env            (en el servidor)
#   2) php artisan key:generate --force           → genera APP_KEY única
#   3) php artisan migrate --force                → crea/esquemas de BD
#   4) php artisan storage:link                   → público/storage para adjuntos
#   5) php artisan optimize                       → cache de config/rutas/vistas
#   6) php artisan queue:work --tries=3 &         → worker de colas (jobs)
#   7) Reiniciar PHP-FPM / supervisor tras cualquier cambio de este archivo.
##############################################################################

# --- NÚCLEO DE LA APLICACIÓN ------------------------------------------------
# Nombre mostrado por el sistema (queda también en cookies/prefix de caché).
APP_NAME="Sistema de Seguimiento de Titulación"
# Entorno: SIEMPRE 'production' en el servidor real.
APP_ENV=production
# Clave de cifrado (cookies, tokens, config). ÚNICA por despliegue.
# Generar con: php artisan key:generate --force   (nunca reutilizar una ya expuesta)
APP_KEY=
# DESACTIVADO en producción: revela trazas, ruta del código y datos sensibles.
APP_DEBUG=false
# URL pública de la API/backend. Debe coincidir con el dominio/HTTPS reales.
APP_URL=https://api.midominio.com
# [Opcional] Si se sirve el backend bajo un subdirectorio (p. ej. /api).
# ASSET_URL=

# Localización por defecto del framework.
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
# APP_FAKER_LOCALE=es_BO   # Solo utilidad en dev/seeds; no afecta producción.

# Driver del "modo mantenimiento"; 'file' es suficiente con un único servidor.
APP_MAINTENANCE_DRIVER=file

# Coste de bcrypt (12 = buen equilibrio seguridad vs. rendimiento de login).
BCRYPT_ROUNDS=12

# --- LOGS -------------------------------------------------------------------
# 'stack' agrupa varios canales; con LOG_STACK=daily los logs rotan a diario.
LOG_CHANNEL=stack
LOG_STACK=daily
# Nivel mínimo de registro. En producción usa 'warning' o 'error' para evitar
# disco lleno con trazas de debug y evitar exponer detalles en los logs.
LOG_LEVEL=error
# Días de retención de logs cuando LOG_STACK=daily.
LOG_DAILY_DAYS=14

# --- BASE DE DATOS (MySQL/MariaDB) -------------------------------------------
# Cadena de conexión completa (opcional, sustituye a los campos individuales).
# DB_URL=mysql://usuario:clave@host:3306/sistemasg
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistemasg
DB_USERNAME=sistemasg_app
# Contraseña FUERTE (>=16 caracteres alfanuméricos+especiales). Idealmente
# inyectada como variable de entorno del proceso (secret manager / supervisor).
DB_PASSWORD=REEMPLAZAR_POR_CLAVE_FUERTE
# Certificado CA si la conexión requiere TLS (RDS/Fly.io, etc.).
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/rds-ca-2019-root.pem

# --- SESIONES ----------------------------------------------------------------
# 'file' sin dependencias extra (recomendado en este despliegue). 'database'
# requiere la tabla 'sessions' (migración aún no generada): solo úsala si la creas.
SESSION_DRIVER=file
# Vida de la sesión en minutos (120 ≈ 2 h).
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Dominio de la cookie. Con API en subdominio: 'api.midominio.com'.
SESSION_DOMAIN=null
# true cuando el sitio se sirve SIEMPRE por HTTPS (obligatorio en producción).
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
# 'lax' es seguro y compatible; 'strict' endurece aún más (menos conveniente).
SESSION_SAME_SITE=lax

# --- COLAS / JOBS ------------------------------------------------------------
# 'database' usa la tabla 'jobs' ya migrada. Ejecutar un worker de fondo:
#   php artisan queue:work database --tries=3 --timeout=60
QUEUE_CONNECTION=database

# --- CACHÉ -------------------------------------------------------------------
# 'database' usa la tabla 'cache' (migración '0001_..._create_cache_table').
CACHE_STORE=database
# Prefijo opcional para aislar caché entre ambientes.
# CACHE_PREFIX=sgs_prod_

# --- CORREO ------------------------------------------------------------------
# SMTP real en producción (Mailtrap, SendGrid, SES, etc.).
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.midominio.com
MAIL_PORT=587
MAIL_USERNAME=REEMPLAZAR_USUARIO_SMTP
MAIL_PASSWORD=REEMPLAZAR_CLAVE_SMTP
# Remitente visible de los correos.
MAIL_FROM_ADDRESS="no-reply@midominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- ALMACENAMIENTO DE DOCUMENTOS --------------------------------------------
# 'public' guarda adjuntos en storage/app/public y se sirven vía storage:link
# desde APP_URL/storage (el frontend los apunta con VITE_STORAGE_URL).
FILESYSTEM_DISK=public
# [Opcional] Escalado horizontal con objeto store:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- SANCTUM / CORS ----------------------------------------------------------
# Dominios con peticiones "estatales" (cookies). Esta app usa tokens Bearer de
# Sanctum (personal access tokens), por lo que no es imprescindible; consérvalo
# por si se habilita la autenticación SPA por cookie en el futuro.
SANCTUM_STATEFUL_DOMAINS=midominio.com,www.midominio.com
# Origen(es) permitidos por CORS para el FFONTT (SPA). Se lee en config/cors.php
# como lista separada por comas. DEBE coincidir exactamente con el dominio real
# del frontend (mismo esquema HTTPS, sin barra diagonal final).
FRONTEND_URL=https://midominio.com

# --- MÓDULO DE TESIS DE GRADO (flujo del estudiante) -------------------------
# Plazo (meses) para presentar el documento final desde la aprobación del
# perfil. El reglamento fija entre 3 y 12 meses: el módulo acota el valor a ese
# rango aunque aquí se escriba otro número. Por defecto: 12.
TESIS_PLAZO_PRESENTACION_MESES=12
# Días de corrección cuando la revisión es insuficiente o la defensa no fue
# aprobada (reglamento: 90 días). Por defecto: 90.
TESIS_DIAS_CORRECCION=90

# --- VARIABLES USADAS POR VITE (solo necesarias si la SPA se construye aquí) --
# VITE_APP_NAME="${APP_NAME}"