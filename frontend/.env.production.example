##############################################################################
# .env.production.example — PLANTILLA del FRONTEND para PRODUCCIÓN (Vite).
#
# Copia este archivo como `.env.production` y ejecuta `npm run build`. Vite
# compila estas variables en el bundle (SIN secretos: son URLs públicas).
# NUNCA subas `.env.production` a Git; solo esta plantilla es versionable.
#
# Cambia los valores por el dominio real de tu despliegue ANTES del build.
##############################################################################

# URL pública de la API de Laravel (DEBE terminar en /api).
# La consume src/core/config/env.js a través de src/core/http/client.js.
VITE_API_URL=https://api.midominio.com/api

# URL pública del storage de Laravel (documentos adjuntos de cada trámite).
# Equivale a APP_URL/storage del backend (exige 'php artisan storage:link').
# La usa src/core/http/storage.js para construir las URLs descargables.
VITE_STORAGE_URL=https://api.midominio.com/storage

# Puerto usado por `vite preview` al servir el build de producción localmente.
VITE_PORT=4173

# [Opcional] Ruta base si la SPA se publica bajo un subdirectorio (history
# mode). Ejemplo si se sirve desde https://midominio.com/app:
# BASE_URL=/app/