##############################################################################
# .env.example — Variables del FRONTEND (Vue 3 + Vite).
#
# Copia este archivo según el entorno:
#   dev  → cp .env.example .env.development   (vite dev lo lee automáticamente)
#   prod → cp .env.example .env.production    (vite build lo lee automáticamente)
#
# Vite solo expone al bundle las variables que comienzan con VITE_.
##############################################################################

# URL pública de la API de Laravel (DEBE terminar en /api).
# La consume axios en src/core/http/client.js.
VITE_API_URL=http://localhost:8000/api

# URL pública del storage de Laravel (documentos adjuntos de cada trámite).
# Equivale a APP_URL/storage del backend (exige 'php artisan storage:link').
# La usa src/core/http/storage.js para construir URLs descargables.
VITE_STORAGE_URL=http://localhost:8000/storage

# Puerto del servidor de desarrollo (vite dev) y de preview (vite preview).
VITE_PORT=5173