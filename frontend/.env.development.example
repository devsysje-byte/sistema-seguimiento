##############################################################################
# .env.development.example — PLANTILLA del FRONTEND para DESARROLLO (Vite).
#
# Copia este archivo como `.env.development` para el entorno local. Lo lee
# automáticamente `vite dev`. NUNCA subas `.env.development` a Git (ya está en
# .gitignore); solo esta plantilla es versionable.
##############################################################################

# URL pública de la API de Laravel (DEBE terminar en /api).
# La consume src/core/config/env.js a través de src/core/http/client.js.
VITE_API_URL=http://localhost:8000/api

# URL pública del storage de Laravel (documentos adjuntos de cada trámite).
# Equivale a APP_URL/storage del backend (exige 'php artisan storage:link').
# La usa src/core/http/storage.js para construir URLs descargables.
VITE_STORAGE_URL=http://localhost:8000/storage

# Puerto del servidor de desarrollo (vite dev) y de preview (vite preview).
VITE_PORT=5173